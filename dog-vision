#!/bin/sh
# Runs dog-vision from any directory, with this checkout's environment; uv sets it up on first use.
# File arguments stay relative to the directory it is run from, and snapshots are saved there.
if ! command -v uv >/dev/null 2>&1; then
    echo "dog-vision needs uv: https://docs.astral.sh/uv/" >&2
    exit 1
fi
# readlink -f follows a link to this file, e.g. one put into ~/.local/bin.
exec uv run --quiet --project "$(dirname "$(readlink -f "$0")")" dog-vision "$@"
